{
  "name": "Lamplight Reader",
  "short_name": "Lamplight",
  "description": "Online self contained audiobook reader",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ECE6D6",
  "theme_color": "#ECE6D6",
  "icons": [
    { "src": "icon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "icon-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "book", "accept": [".epub", ".pdf", "application/epub+zip", "application/pdf"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [".epub"],
        "application/pdf": [".pdf"]
      }
    }
  ]
}
